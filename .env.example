# ===== 复制为 .env 后修改（docker-compose 自动读取同目录 .env）=====
# 复制命令（群晖 SSH）：cp .env.example .env && vi .env

# GHCR 用户名/组织名，必须是全小写（GitHub Actions 里已强制转小写）
# 例：你的 GitHub 用户名是 ZhangSan，这里写 zhangsan
GHCR_OWNER=your-github-name

# 镜像标签：latest / 某个 commit sha
TAG=latest

# 数据库 root 密码（首次启动时写入，之后改这里不会改库内密码）
MYSQL_ROOT_PASSWORD=JshErp@2026

# Redis 密码（必须与后端一致，application.yml 里默认是 1234abcd，这里用环境变量覆盖）
REDIS_PASSWORD=JshErp@Redis2026

# 前端对外端口（群晖上访问 http://群晖IP:8080）
WEB_PORT=8080

# 后端是否对局域网暴露 9999（默认不暴露，只让 nginx 内网反代；排障时可临时开启）
BACKEND_PORT=9999
