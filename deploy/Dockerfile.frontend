# syntax=docker/dockerfile:1
# jshERP 前端镜像（Vue 2.7 + Vue CLI 3 + webpack 4 → nginx 托管）
# 构建上下文必须是仓库根目录：
#   docker build -f deploy/Dockerfile.frontend -t jsherp-frontend:local .
#
# 关键：@vue/cli-service 是 3.x（webpack 4），Node 17+ 会因 OpenSSL 3
#       报 ERR_OSSL_EVP_UNSUPPORTED，所以构建阶段必须用 Node 16。

########################  构建阶段  ########################
FROM node:16-bullseye AS build

# 国内/慢链路加速：Maven 走了阿里云，npm 这里用 npmmirror
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    YARN_REGISTRY=https://registry.npmmirror.com

# NAS 只有 4GB 内存：限制 V8 堆，避免 webpack 撑爆被内核 OOM kill（exit 137）
ENV NODE_OPTIONS="--max_old_space_size=1024"

WORKDIR /src

# node:16-bullseye 镜像自带 yarn 1.22.19，不需要再 npm i -g（会 EEXIST 失败）
COPY jshERP-web/package.json ./package.json

# 无 lock 文件，靠 --ignore-engines 容忍老包的 engines 声明
RUN yarn install --network-timeout 900000 --ignore-engines --registry https://registry.npmmirror.com

COPY jshERP-web/ ./

# 生产构建（Vue CLI 3 的 build 不跑 eslint）
RUN yarn build

########################  运行阶段  ########################
FROM nginx:1.27-alpine

ENV TZ=Asia/Shanghai
RUN apk add --no-cache tzdata \
 && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
